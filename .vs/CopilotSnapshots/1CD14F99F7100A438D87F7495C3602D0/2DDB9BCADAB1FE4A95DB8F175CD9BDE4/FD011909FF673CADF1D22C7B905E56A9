<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="snitch2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:snitch2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Snitch2 - Network Monitor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Refresh Button and Stats -->
        <Grid Grid.Row="0" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="Refresh"
                    Margin="0,0,16,0">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5"/>
                </Button.KeyboardAccelerators>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="24" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Processes" FontSize="12" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalProcesses, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Connections" FontSize="12" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalConnections, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>

            <ProgressRing Grid.Column="3" 
                         IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                         Width="24" Height="24"/>
        </Grid>

        <!-- Main Content - Process Groups List -->
        <ListView Grid.Row="1" 
                  ItemsSource="{x:Bind ViewModel.ProcessGroups, Mode=OneWay}"
                  SelectionMode="None"
                  Padding="8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="Margin" Value="0,4"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander HorizontalAlignment="Stretch" 
                             HorizontalContentAlignment="Stretch"
                             IsExpanded="False">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                          Text="{Binding ProcessName}" 
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1" 
                                          Text="{Binding ProcessIdText}" 
                                          Opacity="0.7"
                                          VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2" 
                                          Text="{Binding ExecutablePath}" 
                                          Opacity="0.6"
                                          FontSize="12"
                                          TextTrimming="CharacterEllipsis"
                                          VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="3" 
                                          Text="{Binding ConnectionCountText}" 
                                          Opacity="0.7"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Expander.Header>

                        <Expander.Content>
                            <Grid Margin="0,8,0,0">
                                <!-- Connection Table Header -->
                                <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                      Padding="12,8"
                                      Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Local Endpoint" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="Remote Endpoint" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="Remote Host" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="State" FontWeight="SemiBold" FontSize="12"/>
                                </Grid>

                                <!-- Connection Items -->
                                <ItemsRepeater ItemsSource="{Binding Connections}" Margin="0,32,0,0">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="12,8" 
                                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                                                  BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" 
                                                          Text="{Binding LocalEndPoint}" 
                                                          FontFamily="Consolas"
                                                          FontSize="12"/>

                                                <TextBlock Grid.Column="1" 
                                                          Text="{Binding RemoteEndPoint}" 
                                                          FontFamily="Consolas"
                                                          FontSize="12"/>

                                                <TextBlock Grid.Column="2" 
                                                          Text="{Binding RemoteHostName}" 
                                                          FontSize="12"
                                                          TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Column="3" 
                                                       Background="{Binding StateBrush}"
                                                       CornerRadius="4"
                                                       Padding="8,4"
                                                       HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding State}" 
                                                              Foreground="White"
                                                              FontSize="11"
                                                              FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                        </Expander.Content>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                Padding="16,8">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                      Opacity="0.7"
                      FontSize="12"/>
        </Border>
    </Grid>
</Window>
