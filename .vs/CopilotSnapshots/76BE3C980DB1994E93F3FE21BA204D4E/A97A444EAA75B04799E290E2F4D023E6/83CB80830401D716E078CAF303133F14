<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Snitch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snitch"
    xmlns:converters="using:Snitch.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Snitch">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <converters:ByteSizeConverter x:Key="ByteSizeConverter"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Snitch" 
                          Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          FontSize="12"
                          Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ToggleButton 
                    Content="Internet Only" 
                    IsChecked="{x:Bind ViewModel.HideLocalConnections, Mode=TwoWay}"
                    ToolTipService.ToolTip="Hide local connections (127.0.0.1, 0.0.0.0)"/>
                <StackPanel>
                    <TextBlock Text="Total" FontSize="12" Opacity="0.7" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalConnections, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                             Width="24" Height="24"/>
            </StackPanel>
        </Grid>

        <!-- Table Header -->
        <Grid Grid.Row="1" 
              Padding="16,8" 
              Background="{ThemeResource DividerStrokeColorDefaultBrush }"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1">
          
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="PID" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="State" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="Local Endpoint" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="Remote Endpoint" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="Remote Host" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6" Text="Bytes Sent" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="7" Text="Bytes Received" FontWeight="SemiBold"/>
        </Grid>

        <!-- Table Rows -->
    <ScrollViewer Grid.Row="1" Margin="0,38,0,0" Background="{ThemeResource LayerFillColorDefaultBrush }">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}" Margin="16,0">
                <ItemsRepeater.Layout>
                    <StackLayout/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                               BorderThickness="0,0,0,1"
                               Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                          Text="{Binding ProcessName}" 
                                          TextTrimming="CharacterEllipsis"
                                          ToolTipService.ToolTip="{Binding ExecutablePath}"/>

                                <TextBlock Grid.Column="1" 
                                          Text="{Binding ProcessId}" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <Border Grid.Column="2" 
                                       Background="{Binding StateBrush}" 
                                       CornerRadius="3" 
                                       Padding="6,2"
                                       HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding State}" 
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              Foreground="White"/>
                                </Border>

                                <TextBlock Grid.Column="3" 
                                          Text="{Binding LocalEndPoint}" 
                                          FontFamily="Consolas"
                                          TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="4" 
                                          Text="{Binding RemoteEndPoint}" 
                                          FontFamily="Consolas"
                                          TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="5" 
                                          Text="{Binding RemoteHostName}" 
                                          FontFamily="Consolas"
                                          TextTrimming="CharacterEllipsis"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <TextBlock Grid.Column="6" 
                                          Text="{Binding BytesSent, Converter={StaticResource ByteSizeConverter}}" 
                                          FontFamily="Consolas"
                                          TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="7" 
                                          Text="{Binding BytesReceived, Converter={StaticResource ByteSizeConverter}}" 
                                          FontFamily="Consolas"
                                          TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Window>
