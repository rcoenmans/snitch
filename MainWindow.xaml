<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Snitch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snitch"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Snitch">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Snitch" 
                           Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ToggleButton 
                    IsChecked="{x:Bind ViewModel.HideLocalConnections, Mode=TwoWay}"
                    ToolTipService.ToolTip="Hide local connections (127.0.0.1, 0.0.0.0)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71C;" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                        <TextBlock Text="Internet Only" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    x:Name="ThemeToggleButton"
                    IsChecked="{x:Bind IsDarkMode, Mode=OneWay}"
                    Click="OnThemeToggleClick"
                    ToolTipService.ToolTip="Toggle dark mode">
                    <FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                </ToggleButton>
                <StackPanel>
                    <TextBlock Text="Total" FontSize="12" Opacity="0.7" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalConnections, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                              Width="24" Height="24"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush }">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" 
                      Padding="16,8" 
                      Background="{ThemeResource DividerStrokeColorDefaultBrush }"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" MinWidth="100"/>
                        <ColumnDefinition Width="70" MinWidth="50"/>
                        <ColumnDefinition Width="90" MinWidth="60"/>
                        <ColumnDefinition Width="180" MinWidth="100"/>
                        <ColumnDefinition Width="180" MinWidth="100"/>
                        <ColumnDefinition Width="120" MinWidth="80"/>
                        <ColumnDefinition Width="120" MinWidth="80"/>
                        <ColumnDefinition Width="*" MinWidth="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Thumb Grid.Column="0" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.3" Background="Transparent" Tag="0" DragDelta="OnColumnResize"/>
                    <TextBlock Grid.Column="1" Text="PID" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Thumb Grid.Column="1" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.3" Background="Transparent" Tag="1" DragDelta="OnColumnResize"/>
                    <TextBlock Grid.Column="2" Text="State" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Thumb Grid.Column="2" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.3" Background="Transparent" Tag="2" DragDelta="OnColumnResize"/>
                    <TextBlock Grid.Column="3" Text="Local Endpoint" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Thumb Grid.Column="3" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.3" Background="Transparent" Tag="3" DragDelta="OnColumnResize"/>
                    <TextBlock Grid.Column="4" Text="Remote Endpoint" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Thumb Grid.Column="4" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.3" Background="Transparent" Tag="4" DragDelta="OnColumnResize"/>
                    <TextBlock Grid.Column="5" Text="TX" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Thumb Grid.Column="5" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.3" Background="Transparent" Tag="5" DragDelta="OnColumnResize"/>
                    <TextBlock Grid.Column="6" Text="RX" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="Remote Host" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>

                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}" Margin="16,0">
                    <ItemsRepeater.Layout>
                        <StackLayout/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                                    BorderThickness="0,0,0,1"
                                    Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" MinWidth="100"/>
                                        <ColumnDefinition Width="70" MinWidth="50"/>
                                        <ColumnDefinition Width="90" MinWidth="60"/>
                                        <ColumnDefinition Width="180" MinWidth="100"/>
                                        <ColumnDefinition Width="180" MinWidth="100"/>
                                        <ColumnDefinition Width="120" MinWidth="80"/>
                                        <ColumnDefinition Width="120" MinWidth="80"/>
                                        <ColumnDefinition Width="*" MinWidth="100"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <TextBlock Text="{Binding ProcessName}" 
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding ExecutablePath, Converter={StaticResource NonEmptyStringTooltipConverter}}"/>
                                    </Grid>

                                    <TextBlock Grid.Column="1" 
                                                Text="{Binding ProcessId}" 
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <Border Grid.Column="2" 
                                             Background="{Binding StateBrush}" 
                                             CornerRadius="3" 
                                             Padding="6,2"
                                             HorizontalAlignment="Left">
                                         <TextBlock Text="{Binding State}" 
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"/>
                                    </Border>

                                    <TextBlock Grid.Column="3" 
                                                Text="{Binding LocalEndPoint}" 
                                                FontFamily="Consolas"
                                                TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="4" 
                                                Text="{Binding RemoteEndPoint}" 
                                                FontFamily="Consolas"
                                                TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="5" 
                                                Text="{Binding BytesSentText}" 
                                                FontFamily="Consolas"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="6" 
                                                Text="{Binding BytesReceivedText}" 
                                                FontFamily="Consolas"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="7" 
                                                Text="{Binding RemoteHostName}" 
                                                FontFamily="Consolas"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
